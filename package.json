{
  "name": "quicknote-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:popup && npm run build:content && npm run build:background && node scripts/postbuild.mjs",
    "build:popup": "vite build --config vite.popup.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "build:background": "vite build --config vite.background.config.ts",
    "dev": "npm run build:popup -- --watch & npm run build:content -- --watch",
    "generate-icons": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "canvas": "^3.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.4"
  }
}
